{
  "schema_version": 1,
  "description": "Paper-selected CNN baseline for convergence-factor regression.",
  "device": "auto",
  "dataset": {
    "root": "datasets",
    "samples": "datasets/ml/index/paper_v1/samples.jsonl",
    "splits": "datasets/ml/index/paper_v1/splits.json"
  },
  "model": {
    "input_channels": 3,
    "view_size": 100,
    "conv_width": 40,
    "conv_depth": 3,
    "kernel_size": 3,
    "pool_size": 2,
    "dropout": 0.25,
    "embedding_width": 128,
    "scalar_features": 2,
    "dense_width": 128,
    "dense_depth": 5
  },
  "training": {
    "seed": 2026,
    "batch_size": 32,
    "max_epochs": 500,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "early_stopping_patience": 40,
    "early_stopping_min_delta": 1e-7,
    "num_workers": 0,
    "cache_capacity": 1024,
    "deterministic": true,
    "torch_threads": 0
  },
  "output": {
    "directory": "weights/cnn_paper_v1",
    "report": "reports/ml_phase_3_training_report.md"
  }
}
